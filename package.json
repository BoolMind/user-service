{
  "name": "user-service",
  "version": "1.0.0",
  "description": "User Microservice",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node -r dotenv/config ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "proto:generate": "buf generate ../ecommerce-contracts && buf build ../ecommerce-contracts -o ../ecommerce-contracts/descriptor.binpb",
    "migration:create": "typeorm-ts-node-commonjs migration:create src/database/migrations",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@bufbuild/protovalidate": "^1.2.0",
    "@ecommerce/common": "file:../common/ecommerce-common-1.1.1.tgz",
    "@ecommerce/contracts": "file:../ecommerce-contracts/ecommerce-contracts-1.1.1.tgz",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "joi": "^18.2.3",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.23.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^26.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
